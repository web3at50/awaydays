# Copy to .env.local (never committed) and fill in. Variable names only here.
# In production, set the same names in your host's environment (Vercel:
# Project → Settings → Environment Variables), then redeploy.

# ---- Required: Supabase (auth, database, storage) ------------------------
# Project → Settings → API. Use the newer key format (sb_publishable_ /
# sb_secret_), not the legacy anon / service_role JWTs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser or commit it.
SUPABASE_SECRET_KEY=

# ---- Required for maps: a real contact address ---------------------------
# Geocoding (Nominatim) and road routing (OSRM) are free community services
# whose usage policies require an identifying User-Agent with a contact.
# Without this, entries get no coordinates, so no pins or journeys.
GEO_CONTACT_EMAIL=

# ---- Optional: Google Maps rendering -------------------------------------
# Without these, maps render with Leaflet instead (see below). The key is
# public by design — lock it down in the Google Cloud console (HTTP referrer
# restriction, Maps JavaScript API only, and cap the daily map-loads quota
# so the free tier can never be exceeded). The Map ID comes from Map
# management (JavaScript, vector) and is needed for advanced markers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---- Optional: English-labelled tiles for the Leaflet fallback -----------
# An ArcGIS Location Platform key for Esri's basemap tiles. Without it the
# Leaflet fallback uses OpenStreetMap tiles (labels in each local language).
# ArcGIS keys expire yearly — set a reminder to renew.
NEXT_PUBLIC_ARCGIS_API_KEY=

# ---- Optional: research search on the plan page (Vercel AI Gateway) ------
# Enables the "Find places" / "Deep dive" search. Hidden when unset.
AI_GATEWAY_API_KEY=
# Gateway model id for the search; leave blank for the default
# (openai/gpt-5.6-luna, set in src/lib/plan-search.ts).
PLAN_SEARCH_MODEL=

# ---- Optional: Tripadvisor ratings on saved ideas (Terra API) ------------
# Billed per location returned (first 1,000 free); results are cached on
# the idea for ever. Hidden when unset.
TRIPADVISOR_API_KEY=
